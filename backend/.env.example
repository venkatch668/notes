# TEMPLATE ONLY — this file is COMMITTED to git.
# Never put real values here. Copy it to `.env` (gitignored) and fill that in.
#
#   cp .env.example .env

# ---------------------------------------------------------------- Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO

# --------------------------------------------------------------- Database
# Supabase → Settings → Database → Connection string → URI
# Use the POOLER host (port 6543) when deploying to Render.
# The "postgresql://" prefix is rewritten to the async driver automatically.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_ECHO=false

# ------------------------------------------------------------------- Auth
# This service only *verifies* tokens. It therefore needs public values only —
# no Supabase API key of any kind. Holding a secret you do not need is a
# liability, not a convenience.
#
# Supabase → Settings → API → Project URL
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Optional: only if your JWKS lives somewhere other than the default
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Legacy HS256 projects only (Settings → API → JWT Secret). Leave blank when
# your project issues asymmetric tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Local development only. The API refuses to honour this when
# ENVIRONMENT=production.
AUTH_DISABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ------------------------------------------------------------------- HTTP
CORS_ORIGINS=http://localhost:5173,https://venkatch668.github.io

# ---------------------------------------------------------------------------
# NOT USED BY THIS SERVICE — listed so nobody adds them by mistake:
#
#   SUPABASE_PUBLISHABLE_KEY   belongs in the FRONTEND (VITE_SUPABASE_ANON_KEY)
#   SUPABASE_SECRET_KEY        service-role key. Bypasses row-level security.
#                              This backend talks to Postgres directly and has
#                              no reason to hold it.
# ---------------------------------------------------------------------------
