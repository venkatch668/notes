# TEMPLATE — committed to git. Copy to `.env.local` and fill that in.
#
# Leave these BLANK (or omit the file entirely) to run the app in local mode:
# no backend, no login, everything in localStorage. That is what the current
# GitHub Pages build does.
#
# Set them to switch the app to server mode: Supabase login + FastAPI backend
# + offline cache and replay queue.

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://nvhxqogbhcdlberzyauc.supabase.co
# Supabase → Settings → API → publishable / anon key.
# This key is PUBLIC by design and safe in a browser bundle. It is NOT the
# service-role secret key, which must never appear in frontend code.
VITE_SUPABASE_ANON_KEY=sb_publishable_Lr5fpmduo2ons7eyE-NLlA_aQ6Lhzog

# Where the FastAPI backend lives. Defaults to /api/v1 (same origin, proxied
# in dev). Set the full URL when the API is on Render and the UI on Pages.
VITE_API_URL=
